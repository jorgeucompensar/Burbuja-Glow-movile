rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function firmado() {
      return request.auth != null;
    }

    function perfil() {
      return firmado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data
        : null;
    }

    function esAdmin() {
      return firmado() && perfil() != null && perfil().rol == 'ADMIN';
    }

    function esVendedor() {
      return firmado() && perfil() != null && perfil().rol == 'VENDEDOR';
    }

    function esPropio(uid) {
      return firmado() && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow read: if esPropio(uid) || esAdmin();
      allow create: if request.resource.data.uid == uid
        && ((esPropio(uid) && request.resource.data.rol in ['COMPRADOR', 'VENDEDOR'])
          || (esAdmin() && request.resource.data.rol in ['ADMIN', 'VENDEDOR', 'COMPRADOR']));
      allow update: if esAdmin()
        || (esPropio(uid)
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.estado == resource.data.estado);
      allow delete: if esAdmin();
    }

    match /productos/{id} {
      allow read: if true;
      allow create: if esAdmin() || (esVendedor() && request.resource.data.vendedorId == request.auth.uid);
      allow update: if esAdmin() || (esVendedor() && resource.data.vendedorId == request.auth.uid);
      allow delete: if esAdmin() || (esVendedor() && resource.data.vendedorId == request.auth.uid);
    }

    match /carritos/{uid}/items/{itemId} {
      allow read, write: if esPropio(uid);
    }

    match /pedidos/{numero} {
      allow read: if esAdmin()
        || (firmado() && resource.data.compradorUid == request.auth.uid)
        || (esVendedor() && request.auth.uid in resource.data.get('vendedorIds', []));
      allow create: if firmado() && request.resource.data.compradorUid == request.auth.uid;
      allow update: if esAdmin()
        || (esVendedor() && request.auth.uid in resource.data.get('vendedorIds', []));
      allow delete: if esAdmin();
    }

    match /config/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
  }
}
